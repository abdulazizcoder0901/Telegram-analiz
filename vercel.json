{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/analyze.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/analyze"
    }
  ],
  "crons": [
    {
      "path": "/api/analyze?refresh=1&format=json",
      "schedule": "17 2 * * *"
    }
  ]
}
